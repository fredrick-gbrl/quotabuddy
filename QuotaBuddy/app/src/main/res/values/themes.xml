<resources>
    <style name="Theme.QuotaBuddy" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/qb_accent</item>
        <item name="android:navigationBarColor">@color/qb_bg</item>
        <item name="android:statusBarColor">@color/qb_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/qb_bg</item>
        <item name="android:alertDialogTheme">@style/Theme.QuotaBuddy.Dialog</item>
    </style>

    <style name="Theme.QuotaBuddy.Dialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/qb_accent</item>
        <item name="android:textColorPrimary">@color/qb_text</item>
        <item name="android:windowBackground">@color/qb_surface</item>
    </style>
</resources>
